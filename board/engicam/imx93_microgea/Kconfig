if TARGET_IMX93_MICROGEA

config SYS_BOARD
	default "imx93_microgea"

config SYS_VENDOR
	default "engicam"

config SYS_CONFIG_NAME
	default "imx93_microgea"

config IMX93_MICROGEA
	bool "Using LPDDR4X Timing and PMIC voltage"
	default y
	select IMX9_DRAM
	select IMX9_LPDDR4X

config IMX93_MICROGEA_1GB
	bool "Using LPDDR4X Timing for 1GB RAM and PMIC voltage"
	default n
	select IMX9_DRAM
	select IMX9_LPDDR4X_1GB

endif
